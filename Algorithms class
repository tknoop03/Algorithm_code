#Sort Based Algorithm --> finds the kth greatest number by sorting all the numbers from greatest to smallest, then taking the position of k. 
def k_greatest(numbers, k):
    numbers.sort(reverse=True)
    return numbers[k - 1]


numbers = [12, 5, 19, 3, 8, 15, 10]
k = 5

answer = k_greatest(numbers, k)
print("The kth greatest number is:", answer)


#Median_of_Median Algorithm --> Divides the data set into groups, then finds the median of each group, then find the median of those medians which is the pivot. Then seperates the 
# original list from greatest to smallest and insterst the median there. Lastly find kth number in list. 
def median_of_medians (numbers,k):
    if len(numbers) <= 5:
        return sorted (numbers)[k-1]
        
    groups = [numbers[i:i+5] for i in range(0,len(numbers),5)]
        
    medians=[sorted(group)[len(group)//2] for group in groups]
             
    pivot = median_of_medians(medians,(len(medians)+1)//2)
    
    greater = [x for x in numbers if x > pivot]
    equal = [x for x in numbers if x == pivot]
    smaller = [x for x in numbers if x < pivot]
    
    if k<=len(smaller):
        return median_of_medians(smaller,k)
    elif k<=len(smaller) + len(equal):
        return pivot
    return median_of_medians (
        smaller,
        k-len(greater)-len(equal)
        )

numbers = [12,5,19,3,8,15,10,21,7]
k = 5

print(median_of_medians(numbers, k))


#iterative_max algorithm --> Goes through each number and keeps track of each one to see if it is larger 
def findmax(list):
    max = list[0]
    
    for x in list:
        if x > max:
            max = x
            
    return max

list = [12,5,19,3,8,15,10]
print(findmax(list))




